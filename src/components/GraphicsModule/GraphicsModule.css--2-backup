/* GraphicsModule.css */
@import url("https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&display=swap");

:root {
  --gm-primary: #00d4ff;
  --gm-secondary: #00ff88;
  --gm-accent: #ff6b35;
  --gm-purple: #a855f7;
  --gm-pink: #f43f5e;
  --gm-bg: #050811;
  --gm-card-bg: rgba(17, 24, 39, 0.7);
  --gm-border: rgba(0, 212, 255, 0.2);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.gm-section {
  position: relative;
  padding: 100px 24px;
  font-family: "Rajdhani", sans-serif;
  background: var(--gm-bg);
  overflow: hidden;
}

/* Animated Background Shapes */
.gm-bg-shapes {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
}

.gm-shape {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.15;
  animation: float 20s infinite ease-in-out;
}

.gm-shape-1 {
  width: 500px;
  height: 500px;
  background: var(--gm-primary);
  top: -150px;
  left: -150px;
  animation-delay: 0s;
}

.gm-shape-2 {
  width: 600px;
  height: 600px;
  background: var(--gm-purple);
  bottom: -200px;
  right: -200px;
  animation-delay: 5s;
}

.gm-shape-3 {
  width: 400px;
  height: 400px;
  background: var(--gm-secondary);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation-delay: 10s;
  opacity: 0.08;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(30px, -30px) scale(1.1); }
  66% { transform: translate(-20px, 20px) scale(0.9); }
}

/* Container */
.gm-container {
  position: relative;
  z-index: 2;
  max-width: 1400px;
  margin: 0 auto;
}

/* Header */
.gm-header {
  text-align: center;
  margin-bottom: 70px;
}

.gm-header-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 20px;
  background: rgba(0, 212, 255, 0.1);
  border: 1px solid var(--gm-border);
  border-radius: 50px;
  font-size: 13px;
  font-weight: 600;
  color: var(--gm-primary);
  margin-bottom: 25px;
  backdrop-filter: blur(10px);
  animation: fadeInUp 0.6s ease;
}

.gm-title {
  font-size: clamp(32px, 6vw, 56px);
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 20px;
  animation: fadeInUp 0.6s ease 0.1s backwards;
}

.gm-title-gradient {
  background: linear-gradient(135deg, var(--gm-primary), var(--gm-secondary), var(--gm-purple));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  position: relative;
  display: inline-block;
}

.gm-title-gradient::after {
  content: '';
  position: absolute;
  bottom: -5px;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--gm-primary), var(--gm-secondary), transparent);
  animation: shimmer 3s infinite;
}

.gm-subtitle {
  font-size: 16px;
  color: #94a3b8;
  max-width: 650px;
  margin: 0 auto 30px;
  line-height: 1.6;
  animation: fadeInUp 0.6s ease 0.2s backwards;
}

.gm-stats {
  display: flex;
  justify-content: center;
  gap: 30px;
  margin-bottom: 30px;
  animation: fadeInUp 0.6s ease 0.3s backwards;
}

.gm-stat {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 18px;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 50px;
  font-size: 13px;
  font-weight: 500;
  color: var(--gm-text-muted);
}

.gm-stat svg {
  color: var(--gm-primary);
}

.gm-download-btn {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 14px 36px;
  background: linear-gradient(135deg, var(--gm-primary), var(--gm-primary) 50%, transparent);
  border: 2px solid rgba(0, 212, 255, 0.5);
  border-radius: 50px;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.3s ease;
  animation: fadeInUp 0.6s ease 0.4s backwards;
  position: relative;
  overflow: hidden;
}

.gm-download-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.gm-download-btn:hover::before {
  width: 300px;
  height: 300px;
}

.gm-download-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(0, 212, 255, 0.3);
  border-color: var(--gm-primary);
}

/* Premium Card */
.gm-premium-card {
  position: relative;
  background: var(--gm-card-bg);
  backdrop-filter: blur(20px);
  border-radius: 40px;
  padding: 50px 45px;
  border: 1px solid var(--gm-border);
  overflow: hidden;
  transition: all 0.5s ease;
}

.gm-premium-card:hover {
  border-color: rgba(0, 212, 255, 0.5);
  box-shadow: 0 30px 60px rgba(0, 212, 255, 0.15);
}

.gm-card-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--gm-primary), var(--gm-secondary), var(--gm-purple), transparent);
  animation: slideGlow 3s infinite;
}

@keyframes slideGlow {
  0%, 100% { transform: translateX(-100%); }
  50% { transform: translateX(100%); }
}

.gm-card-header {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 45px;
}

.gm-header-icon {
  width: 70px;
  height: 70px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.15), rgba(0, 255, 136, 0.08));
  border-radius: 25px;
  font-size: 36px;
  animation: pulseGlow 2s infinite;
}

@keyframes pulseGlow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(0, 212, 255, 0.3); }
  50% { box-shadow: 0 0 0 10px rgba(0, 212, 255, 0); }
}

.gm-card-title {
  font-size: 32px;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8px;
}

.gm-card-subtitle {
  font-size: 14px;
  color: var(--gm-text-muted);
}

/* Premium Grid - 4 items per row */
.gm-premium-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
  margin-bottom: 50px;
}

.gm-premium-item {
  position: relative;
  cursor: pointer;
}

.gm-item-inner {
  position: relative;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 24px;
  padding: 30px 20px;
  text-align: center;
  transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
  border: 1px solid rgba(255, 255, 255, 0.05);
  overflow: hidden;
}

.gm-premium-item:hover .gm-item-inner {
  transform: translateY(-10px);
  background: rgba(0, 212, 255, 0.08);
  border-color: var(--item-color);
  box-shadow: 0 20px 35px rgba(0, 0, 0, 0.3);
}

.gm-icon-circle {
  width: 80px;
  height: 80px;
  margin: 0 auto 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 212, 255, 0.1);
  border-radius: 25px;
  transition: all 0.4s ease;
}

.gm-premium-item:hover .gm-icon-circle {
  background: rgba(0, 212, 255, 0.2);
  transform: scale(1.05) rotate(5deg);
  border-radius: 20px;
}

.gm-item-icon {
  width: 50px;
  height: 50px;
  object-fit: contain;
  filter: drop-shadow(0 0 10px rgba(0, 212, 255, 0.4));
  transition: all 0.3s ease;
}

.gm-premium-item:hover .gm-item-icon {
  transform: scale(1.1);
}

.gm-item-name {
  font-size: 15px;
  font-weight: 600;
  color: #e2e8f0;
  line-height: 1.4;
  letter-spacing: 0.3px;
}

/* Enroll Area */
.gm-enroll-area {
  position: relative;
  text-align: center;
  padding-top: 20px;
}

.gm-enroll-pulse {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 120px;
  height: 120px;
  background: radial-gradient(circle, rgba(0, 212, 255, 0.2), transparent);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: ripple 2s infinite;
  pointer-events: none;
}

@keyframes ripple {
  0% { width: 80px; height: 80px; opacity: 0.8; }
  100% { width: 200px; height: 200px; opacity: 0; }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes shimmer {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* Responsive */
@media (max-width: 1200px) {
  .gm-premium-grid {
    gap: 20px;
  }
  
  .gm-item-name {
    font-size: 13px;
  }
  
  .gm-icon-circle {
    width: 70px;
    height: 70px;
  }
  
  .gm-item-icon {
    width: 42px;
    height: 42px;
  }
}

@media (max-width: 992px) {
  .gm-premium-card {
    padding: 40px 30px;
  }
  
  .gm-premium-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  
  .gm-card-title {
    font-size: 26px;
  }
}

@media (max-width: 768px) {
  .gm-section {
    padding: 60px 16px;
  }
  
  .gm-premium-card {
    padding: 30px 20px;
  }
  
  .gm-card-header {
    flex-direction: column;
    text-align: center;
    gap: 15px;
    margin-bottom: 30px;
  }
  
  .gm-premium-grid {
    grid-template-columns: 1fr;
    gap: 15px;
  }
  
  .gm-stats {
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  
  .gm-stat {
    width: fit-content;
  }
  
  .gm-title {
    font-size: 28px;
  }
  
  .gm-card-title {
    font-size: 24px;
  }
  
  .gm-header-icon {
    width: 55px;
    height: 55px;
    font-size: 28px;
  }
  
  .gm-item-inner {
    display: flex;
    align-items: center;
    gap: 18px;
    text-align: left;
    padding: 18px 20px;
  }
  
  .gm-icon-circle {
    margin: 0;
    width: 55px;
    height: 55px;
  }
  
  .gm-item-icon {
    width: 35px;
    height: 35px;
  }
}

/* Touch devices */
@media (hover: none) and (pointer: coarse) {
  .gm-premium-item:active .gm-item-inner {
    transform: scale(0.98);
  }
  
  .gm-premium-item:hover .gm-item-inner {
    transform: none;
  }
}